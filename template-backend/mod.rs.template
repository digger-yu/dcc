// {isa_name}/mod.rs - Main entry point template
// New ISA Backend - Phase B Implementation
// Template for creating new architecture backends in DCC compiler

/// # Module Structure
/// 
/// Modular backend following proven AArch64 pattern:
///
/// ## Core Modules (implement all)
/// - `backend/`       - Backend trait implementation ✅
/// - `registers/`     - Register definitions ✅  
/// - `abi/`           - Calling convention rules ✅
/// - `asm/`           - Assembly layer abstraction ✅
/// - `codegen/`       - IR lowering pipeline ✅
/// - `emit/`          - Binary section generation ✅
///
/// ## Optional/Specialized Modules
/// - `helpers/`       - Utility functions ⚠️
/// - `special/`       - TLS, MTE, Sanitizer support ⚠️

// ============================================================================
// Module Declarations
// ============================================================================

mod backend;        // Backend trait implementation
mod registers;      // Register constants and utilities
mod abi;            // Calling convention (ISA-specific ABI)
mod asm;            // Assembly handling
mod codegen;        // Core IR lowering
mod emit;           // Statement/expression emission
mod helpers;        // Utility functions
mod special;        // Special features (TLS, etc.)

// Backup original monolith file (for incremental migration)
#[path = "{isa_name}.rs"]
mod {isa_name}_impl;

// ============================================================================
// Public API Re-exports
// ============================================================================

pub use self::registers::*;  // Register definitions
pub use self::abi::*;        // ABI utilities  
pub use self::emit::*;       // Emission utilities
pub use self::helpers::*;    // Helper functions
pub use self::special::*;    // Special feature APIs
