// Basic test program for new ISA backend verification
// Test fundamental C features: arithmetic, conditionals, loops, function calls

#include <stdio.h>

// Test basic arithmetic operations
int add(int a, int b) {
    return a + b;
}

int sub(int a, int b) {
    return a - b;
}

// Test conditional logic
int max(int a, int b) {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

// Test loop construction  
int factorial(int n) {
    int result = 1;
    while (n > 1) {
        result *= n;
        n--;
    }
    return result;
}

// Test array access
int sum_array(int arr[], int count) {
    int total = 0;
    for (int i = 0; i < count; i++) {
        total += arr[i];
    }
    return total;
}

// Main entry point
int main() {
    int a = 42;
    int b = 13;
    
    int sum = add(a, b);
    int diff = sub(a, b);
    int m = max(a, b);
    int fact = factorial(5);
    
    int arr[] = {1, 2, 3, 4, 5};
    int arr_sum = sum_array(arr, 5);
    
    printf("add(%d, %d) = %d\n", a, b, sum);
    printf("sub(%d, %d) = %d\n", a, b, diff);
    printf("max(%d, %d) = %d\n", a, b, m);
    printf("factorial(5) = %d\n", fact);
    printf("sum_array = %d\n", arr_sum);
    
    return 0;
}
