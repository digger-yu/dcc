// <type_traits> - dcc++ C++ 标准库
// 类型特征: 编译期类型查询与类型变换.
//
// 语义说明:
//   - conditional / enable_if 用非类型模板实参 (M30.1) 实现
//     真实选择语义: conditional<B,T,F> 按 B 选 T/F, enable_if
//     在 B=false 时不提供 ::type (SFINAE 惯用法依赖此空体).
//   - trivially_* 系列: dcc 对象均为平凡布局 (无用户析构/拷贝
//     的差异), 恒为 1; is_convertible 近似恒真.
//   - underlying_type<E>: 近似透传 E (dcc 枚举参与算术运算时
//     提升, 与其底层整数类型等价).

namespace std {

    // ===== 类型变换 (type transformations) =====

    // conditional<B, T, F>::type = B ? T : F
    template <bool B, typename T, typename F> struct conditional {
        typedef T type;
    };
    template <typename T, typename F> struct conditional<false, T, F> {
        typedef F type;
    };

    // enable_if<B, T = void>: B 为 true 时提供 ::type = T,
    // 否则无成员 (替换失败 -> SFINAE 跳过)
    template <bool B, typename T = void> struct enable_if {
    };
    template <typename T> struct enable_if<true, T> {
        typedef T type;
    };

    // remove_const / remove_reference / remove_pointer:
    // 近似透传 (dcc 类型系统不携带 cv/引用限定参与模板匹配)
    template <typename T> struct remove_const {
        typedef T type;
    };
    template <typename T> struct remove_reference {
        typedef T type;
    };
    template <typename T> struct remove_pointer {
        typedef T type;
    };

    // underlying_type<E>::type = 枚举 E 的底层整数类型 (近似透传)
    template <typename T> struct underlying_type {
        typedef T type;
    };

    // ===== 类型谓词 (type predicates) =====

    template <typename T> struct is_trivially_destructible {
        enum { value = 1 };
    };
    template <typename T> struct is_trivially_copyable {
        enum { value = 1 };
    };
    template <typename T> struct is_trivially_default_constructible {
        enum { value = 1 };
    };

    // is_same<T, U>: T 与 U 为同一类型时 value = 1
    template <typename T, typename U> struct is_same {
        enum { value = 0 };
    };
    template <typename T> struct is_same<T, T> {
        enum { value = 1 };
    };

    // is_convertible<From, To>: 近似恒真 (标量/引用可互转)
    template <typename From, typename To> struct is_convertible {
        enum { value = 1 };
    };

    // is_pointer<T> / is_integral<T>: 近似恒 0 (按需扩展)
    template <typename T> struct is_pointer {
        enum { value = 0 };
    };
    template <typename T> struct is_integral {
        enum { value = 0 };
    };

    // integral_constant / true_type / false_type (C++11 base)
    template <typename T, T v>
    struct integral_constant {
        static const T value = v;
        typedef T value_type;
        typedef integral_constant type;
    };
    typedef integral_constant<bool, true> true_type;
    typedef integral_constant<bool, false> false_type;

    // is_void<T>: 近似恒 0 (dcc 不区分 void 参与模板匹配)
    template <typename T> struct is_void {
        enum { value = 0 };
    };

    // is_arithmetic<T>: 近似恒 0 (按需扩展)
    template <typename T> struct is_arithmetic {
        enum { value = 0 };
    };

    // is_floating_point<T>: 近似恒 0
    template <typename T> struct is_floating_point {
        enum { value = 0 };
    };

    // is_signed<T> / is_unsigned<T>: 近似恒 0
    template <typename T> struct is_signed {
        enum { value = 0 };
    };
    template <typename T> struct is_unsigned {
        enum { value = 0 };
    };

    // add_const<T> / add_pointer<T>: 近似透传
    template <typename T> struct add_const {
        typedef T type;
    };
    template <typename T> struct add_pointer {
        typedef T* type;
    };

    // decay<T>: 近似透传 (dcc 不携带 cv/引用/数组衰减)
    template <typename T> struct decay {
        typedef T type;
    };

    // is_base_of<Base, Derived>: 近似恒 1 (dcc 继承关系在 lower 端处理)
    template <typename Base, typename Derived>
    struct is_base_of {
        enum { value = 1 };
    };

    // is_class<T>: 近似恒 0 (按需扩展)
    template <typename T> struct is_class {
        enum { value = 0 };
    };

    // is_enum<T>: 近似恒 0
    template <typename T> struct is_enum {
        enum { value = 0 };
    };

    // is_constructible<T, Args...>: 近似恒 1
    template <typename T, typename... Args>
    struct is_constructible {
        enum { value = 1 };
    };

    // is_default_constructible<T>
    template <typename T>
    struct is_default_constructible {
        enum { value = 1 };
    };

    // is_copy_constructible<T>
    template <typename T>
    struct is_copy_constructible {
        enum { value = 1 };
    };

    // is_assignable<T, U>: 近似恒 1
    template <typename T, typename U>
    struct is_assignable {
        enum { value = 1 };
    };

    // is_nothrow_move_constructible<T>: 近似恒 1
    template <typename T>
    struct is_nothrow_move_constructible {
        enum { value = 1 };
    };

}  // namespace std
