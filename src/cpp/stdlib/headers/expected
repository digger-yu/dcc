// <expected> - dcc++ C++ 标准库
// C++23 std::expected<T, E> 通用模板版.
//
// 语义说明:
//   - expected<T, E> 表示 T 或 E 的联合体.
//   - has_value() 判断是否持有值.
//   - value() / error() 访问.
//   - 降级: 用 union + bool 标志位实现.

namespace std {

    // unexpected<E>: 包装错误值
    template <typename E>
    class unexpected {
    public:
        unexpected() : err_() {}
        unexpected(const E& e) : err_(e) {}
        unexpected(E&& e) : err_(e) {}

        const E& error() const { return err_; }
        E& error() { return err_; }

    private:
        E err_;
    };

    // bad_expected_access: 无值时调用 value() 抛出的异常
    template <typename E>
    class bad_expected_access {
    public:
        bad_expected_access() : err_() {}
        bad_expected_access(const E& e) : err_(e) {}

        const E& error() const { return err_; }

    private:
        E err_;
    };

    // unexpect_t: 就地构造错误值的标签
    typedef int unexpect_t;
    static const unexpect_t unexpect = 0;

    // expected<T, E>: 通用模板
    template <typename T, typename E>
    class expected {
    public:
        typedef T value_type;
        typedef E error_type;
        typedef unexpected<E> unexpected_type;

        // Default: 持有默认构造的 T
        expected() : has_val_(1), val_(), err_() {}

        // From value
        expected(const T& v) : has_val_(1), val_(v), err_() {}

        // From unexpected
        expected(const unexpected<E>& u) : has_val_(0), val_(), err_(u.error()) {}

        // Copy
        expected(const expected& o) : has_val_(o.has_val_), val_(o.val_), err_(o.err_) {}

        // Assignment
        expected& operator=(const expected& o) {
            has_val_ = o.has_val_;
            val_ = o.val_;
            err_ = o.err_;
            return *this;
        }

        // Observers
        int has_value() const { return has_val_; }
        int operator bool() const { return has_val_; }

        // Value access
        const T& value() const { return val_; }
        T& value() { return val_; }

        const T& operator*() const { return val_; }
        T& operator*() { return val_; }

        const T* operator->() const { return &val_; }
        T* operator->() { return &val_; }

        // Error access
        const E& error() const { return err_; }
        E& error() { return err_; }

        // Monadic operations (simplified)
        template <typename F>
        auto and_then(F&& f) const {
            if (has_val_) return f(val_);
            return expected<T, E>(unexpected<E>(err_));
        }

        template <typename F>
        auto transform(F&& f) const {
            if (has_val_) return expected<decltype(f(val_)), E>(f(val_));
            return expected<decltype(f(val_)), E>(unexpected<E>(err_));
        }

        template <typename F>
        expected or_else(F&& f) const {
            if (has_val_) return *this;
            return f(err_);
        }

        // value_or
        T value_or(const T& default_val) const {
            return has_val_ ? val_ : default_val;
        }

    private:
        int has_val_;
        T val_;
        E err_;
    };

    // expected<void, E>: void 特化
    template <typename E>
    class expected_void {
    public:
        expected_void() : has_val_(1) {}
        expected_void(const unexpected<E>& u) : has_val_(0), err_(u.error()) {}

        int has_value() const { return has_val_; }
        const E& error() const { return err_; }

    private:
        int has_val_;
        E err_;
    };

    // make_unexpected helper
    template <typename E>
    unexpected<E> make_unexpected(const E& e) {
        return unexpected<E>(e);
    }

}  // namespace std
