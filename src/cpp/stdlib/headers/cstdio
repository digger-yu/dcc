// <cstdio> - dcc++ C++ 标准库
// printf / scanf / fopen / FILE 等 (薄包装 libc)

extern "C" {
    struct _IO_FILE;
    typedef struct _IO_FILE FILE;

    extern FILE* stdout;
    extern FILE* stderr;
    extern FILE* stdin;

    int    printf(const char* fmt, ...);
    int    fprintf(FILE* fp, const char* fmt, ...);
    int    sprintf(char* s, const char* fmt, ...);
    int    snprintf(char* s, size_t n, const char* fmt, ...);
    int    vprintf(const char* fmt, void* ap);
    int    vfprintf(FILE* fp, const char* fmt, void* ap);
    int    vsprintf(char* s, const char* fmt, void* ap);

    int    scanf(const char* fmt, ...);
    int    fscanf(FILE* fp, const char* fmt, ...);
    int    sscanf(const char* s, const char* fmt, ...);

    FILE*  fopen(const char* path, const char* mode);
    FILE*  fdopen(int fd, const char* mode);
    FILE*  freopen(const char* path, const char* mode, FILE* fp);
    int    fclose(FILE* fp);
    int    fflush(FILE* fp);

    size_t fread(void* buf, size_t esz, size_t cnt, FILE* fp);
    size_t fwrite(const void* buf, size_t esz, size_t cnt, FILE* fp);
    int    fgetc(FILE* fp);
    int    getc(FILE* fp);
    int    fputc(int c, FILE* fp);
    int    putc(int c, FILE* fp);
    int    getchar(void);
    int    putchar(int c);
    char*  fgets(char* s, int n, FILE* fp);
    int    fputs(const char* s, FILE* fp);
    int    puts(const char* s);

    int    feof(FILE* fp);
    int    ferror(FILE* fp);
    int    fileno(FILE* fp);

    int    remove(const char* path);
    int    rename(const char* oldp, const char* newp);
}

namespace std {
    // M52: 这里**不再**提供 `printf/fprintf/sprintf/snprintf` 的转发包装.
    //
    // 之前的写法是 `inline int printf(const char* fmt, ...) { return ::printf(fmt); }`:
    // C/C++ 无法把一个 `...` 形参直接传给另一个 `...` 形参 (必须走 va_start +
    // vfprintf), 所以这些包装会**静默丢掉全部可变实参** —— `std::printf("%d\n", 5)`
    // 在 g++ 下输出 `5`, 在 dcc 下输出未初始化的寄存器 (与真值不一致且无任何诊断).
    // 保留一个错的实现比不实现更糟, 因此删除: 现在 `std::printf(...)` 会硬报
    // "'printf' not found in qualified name".
    // 需要格式化输出的代码请用全局 `::printf` (C++ 允许 [c.headers] 的这份名字)
    // 或 C++23 的 `std::print`/`std::println` (见 <print>, 由参数包摊平实现).
    // 非变参的函数照旧转发, 它们的包装是等价的.

    inline FILE*  fopen(const char* path, const char* mode) { return ::fopen(path, mode); }
    inline int    fclose(FILE* fp) { return ::fclose(fp); }
    inline int    fflush(FILE* fp) { return ::fflush(fp); }
    inline size_t fread(void* buf, size_t esz, size_t cnt, FILE* fp) { return ::fread(buf, esz, cnt, fp); }
    inline size_t fwrite(const void* buf, size_t esz, size_t cnt, FILE* fp) { return ::fwrite(buf, esz, cnt, fp); }

    inline int    getchar(void) { return ::getchar(); }
    inline int    putchar(int c) { return ::putchar(c); }
    inline int    puts(const char* s) { return ::puts(s); }
    inline char*  fgets(char* s, int n, FILE* fp) { return ::fgets(s, n, fp); }
    inline int    fputs(const char* s, FILE* fp) { return ::fputs(s, fp); }
}
