// <functional> - dcc++ C++ 标准库
// std::function<R(Args...)> 类型擦除函数包装器 + 常用函数对象.
//
// 语义说明:
//   - function<R(Args...)> 降级为函数指针 + 调用包装.
//   - dcc 的类型擦除简化: 只支持函数指针, 不支持 lambda 捕获.
//   - plus/minus/multiplies/divides/modulus: 算术函数对象.
//   - equal_to/not_equal_to/less/greater/less_equal/greater_equal: 比较函数对象.
//   - logical_and/logical_or/logical_not: 逻辑函数对象.
//   - negate/negate: 取反函数对象.
//   - ref/cref: 引用包装 (简化版).
//   - bind / mem_fn: 占位 (简化版).

namespace std {

    // ===== function<R(Args...)> =====
    // 简化版: 只支持无参/单参函数指针, 类型擦除通过 void*
    template <typename Signature>
    class function;

    // Specialization for R()
    template <typename R>
    class function<R()> {
    public:
        function() : fp_(0) {}
        function(R(*fp)()) : fp_(fp) {}
        R operator()() const { return fp_(); }
        int empty() const { return fp_ == 0; }
        void operator=(void* fp) { fp_ = (R(*)())fp; }
    private:
        R(*fp_)();
    };

    // Specialization for R(A)
    template <typename R, typename A>
    class function<R(A)> {
    public:
        function() : fp_(0) {}
        function(R(*fp)(A)) : fp_(fp) {}
        R operator()(A a) const { return fp_(a); }
        int empty() const { return fp_ == 0; }
        void operator=(void* fp) { fp_ = (R(*)(A))fp; }
    private:
        R(*fp_)(A);
    };

    // Specialization for R(A, B)
    template <typename R, typename A, typename B>
    class function<R(A, B)> {
    public:
        function() : fp_(0) {}
        function(R(*fp)(A, B)) : fp_(fp) {}
        R operator()(A a, B b) const { return fp_(a, b); }
        int empty() const { return fp_ == 0; }
    private:
        R(*fp_)(A, B);
    };

    // ===== Arithmetic function objects =====
    template <typename T> struct plus {
        T operator()(const T& a, const T& b) const { return a + b; }
    };
    template <typename T> struct minus {
        T operator()(const T& a, const T& b) const { return a - b; }
    };
    template <typename T> struct multiplies {
        T operator()(const T& a, const T& b) const { return a * b; }
    };
    template <typename T> struct divides {
        T operator()(const T& a, const T& b) const { return a / b; }
    };
    template <typename T> struct modulus {
        T operator()(const T& a, const T& b) const { return a % b; }
    };
    template <typename T> struct negate {
        T operator()(const T& a) const { return -a; }
    };

    // ===== Comparison function objects =====
    template <typename T> struct equal_to {
        int operator()(const T& a, const T& b) const { return a == b; }
    };
    template <typename T> struct not_equal_to {
        int operator()(const T& a, const T& b) const { return a != b; }
    };
    template <typename T> struct less {
        int operator()(const T& a, const T& b) const { return a < b; }
    };
    template <typename T> struct greater {
        int operator()(const T& a, const T& b) const { return a > b; }
    };
    template <typename T> struct less_equal {
        int operator()(const T& a, const T& b) const { return a <= b; }
    };
    template <typename T> struct greater_equal {
        int operator()(const T& a, const T& b) const { return a >= b; }
    };

    // ===== Logical function objects =====
    template <typename T> struct logical_and {
        int operator()(const T& a, const T& b) const { return a && b; }
    };
    template <typename T> struct logical_or {
        int operator()(const T& a, const T& b) const { return a || b; }
    };
    template <typename T> struct logical_not {
        int operator()(const T& a) const { return !a; }
    };

}  // namespace std
