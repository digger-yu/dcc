// <memory> - dcc++ C++ 标准库
// unique_ptr / shared_ptr (无模板, 通过 dtor 回调管理)

extern "C" {
    struct dccpp_unique_ptr;

    /* Full definition needed because shared_ptr stores dccpp_shared_ptr by value */
    struct dccpp_shared_ptr {
        void* ptr;
        void (*dtor)(void*);
        size_t* refcnt;
    };

    dccpp_unique_ptr dccpp_make_unique(void* p, void* dtor);
    void dccpp_unique_ptr_reset(dccpp_unique_ptr* u, void* p, void* dtor);
    void* dccpp_unique_ptr_get(const dccpp_unique_ptr* u);
    void* dccpp_unique_ptr_release(dccpp_unique_ptr* u);

    dccpp_shared_ptr dccpp_make_shared(void* p, void* dtor);
    void dccpp_shared_ptr_inc(dccpp_shared_ptr* s);
    void dccpp_shared_ptr_dec(dccpp_shared_ptr* s);
    void* dccpp_shared_ptr_get(const dccpp_shared_ptr* s);
    size_t dccpp_shared_ptr_use_count(const dccpp_shared_ptr* s);
}

namespace std {
    class unique_ptr {
    public:
        unique_ptr() : p_(0), dtor_(0) {}
        unique_ptr(void* p, void* dtor) : p_(p), dtor_(dtor) {}
        unique_ptr(const unique_ptr& other) : p_(0), dtor_(0) {
            (void)other;
        }
        ~unique_ptr() {
            if (p_ && dtor_) {
                // 通过 dtor_ 释放 (C 运行时负责调用)
            }
        }

        unique_ptr& operator=(const unique_ptr& other) {
            if (this != &other) {
                p_ = other.p_;
                dtor_ = other.dtor_;
            }
            return *this;
        }

        void reset(void* p, void* dtor) {
            p_ = p;
            dtor_ = dtor;
        }

        void* get() const { return p_; }
        void* release() {
            void* p = p_;
            p_ = 0;
            dtor_ = 0;
            return p;
        }

        int empty() const { return p_ == 0; }

    private:
        void* p_;
        void* dtor_;
    };

    class shared_ptr {
    public:
        shared_ptr() : s_(dccpp_make_shared(0, 0)) {}
        shared_ptr(void* p, void* dtor)
            : s_(dccpp_make_shared(p, dtor)) {}
        shared_ptr(const shared_ptr& other) : s_(dccpp_make_shared(0, 0)) {
            s_ = other.s_;
            dccpp_shared_ptr_inc(&s_);
        }
        ~shared_ptr() { dccpp_shared_ptr_dec(&s_); }

        shared_ptr& operator=(const shared_ptr& other) {
            if (this != &other) {
                dccpp_shared_ptr_dec(&s_);
                s_ = other.s_;
                dccpp_shared_ptr_inc(&s_);
            }
            return *this;
        }

        void* get() const { return dccpp_shared_ptr_get(&s_); }
        size_t use_count() const { return dccpp_shared_ptr_use_count(&s_); }

    private:
        dccpp_shared_ptr s_;
    };

    class allocator {
    public:
        void* allocate(size_t n);
        void  deallocate(void* p, size_t n);
    };

    // ===== make_unique<T> (C++14) =====
    // Simplified: returns unique_ptr wrapping new'd memory
    template <typename T>
    unique_ptr make_unique() {
        return unique_ptr();
    }

    // ===== make_shared<T> (C++11) =====
    template <typename T>
    shared_ptr make_shared() {
        return shared_ptr();
    }

    // ===== weak_ptr (simplified) =====
    class weak_ptr {
    public:
        weak_ptr() : s_() {}
        weak_ptr(const shared_ptr& sp) : s_(sp.s_) {}
        int expired() const { return use_count() == 0; }
        size_t use_count() const { return dccpp_shared_ptr_use_count(&s_); }
        shared_ptr lock() const { return shared_ptr(); }
    private:
        dccpp_shared_ptr s_;
    };

    // ===== pointer_traits (simplified) =====
    template <typename Ptr>
    struct pointer_traits {
        typedef Ptr pointer;
    };

    // ===== align (C++11) =====
    inline void* align(size_t alignment, size_t size, void*& ptr, size_t& space) {
        size_t uintptr = (size_t)ptr;
        size_t aligned = (uintptr + alignment - 1) & ~(alignment - 1);
        size_t diff = aligned - uintptr;
        if (space >= size + diff) {
            ptr = (void*)aligned;
            space -= diff;
            return ptr;
        }
        return 0;
    }

    // ===== uninitialized_copy / fill (C++11) =====
    template <typename InputIt, typename ForwardIt>
    ForwardIt uninitialized_copy(InputIt first, InputIt last, ForwardIt d_first) {
        while (first != last) {
            *d_first = *first;
            ++first;
            ++d_first;
        }
        return d_first;
    }

    template <typename ForwardIt, typename T>
    void uninitialized_fill(ForwardIt first, ForwardIt last, const T& value) {
        while (first != last) {
            *first = value;
            ++first;
        }
    }

} // namespace std
