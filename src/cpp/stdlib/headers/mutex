// <mutex> - dcc++ C++ 标准库 (M18)
//
// std::mutex (非递归) / std::recursive_mutex. 不支持 timed_mutex
// (pthread timedlock 留给 M19). lock_guard 是 RAII 包装.

extern "C" {
    struct dccpp_mutex;
    struct dccpp_recursive_mutex;

    dccpp_mutex*           dccpp_mutex_new(void);
    void                   dccpp_mutex_free(dccpp_mutex* m);
    void                   dccpp_mutex_lock(dccpp_mutex* m);
    int                    dccpp_mutex_trylock(dccpp_mutex* m);
    void                   dccpp_mutex_unlock(dccpp_mutex* m);

    dccpp_recursive_mutex* dccpp_rmutex_new(void);
    void                   dccpp_rmutex_free(dccpp_recursive_mutex* m);
    void                   dccpp_rmutex_lock(dccpp_recursive_mutex* m);
    void                   dccpp_rmutex_unlock(dccpp_recursive_mutex* m);
}

namespace std {
    class mutex {
    public:
        mutex() : p_(dccpp_mutex_new()) {}
        ~mutex() { if (p_) dccpp_mutex_free(p_); }
        mutex(const mutex&) = 0;
        mutex& operator=(const mutex&) = 0;

        void lock()    { dccpp_mutex_lock(p_); }
        int  try_lock(){ return dccpp_mutex_trylock(p_); }
        void unlock()  { dccpp_mutex_unlock(p_); }
        dccpp_mutex* native_handle() { return p_; }
    private:
        dccpp_mutex* p_;
    };

    class recursive_mutex {
    public:
        recursive_mutex() : p_(dccpp_rmutex_new()) {}
        ~recursive_mutex() { if (p_) dccpp_rmutex_free(p_); }
        recursive_mutex(const recursive_mutex&) = 0;
        recursive_mutex& operator=(const recursive_mutex&) = 0;

        void lock()    { dccpp_rmutex_lock(p_); }
        void unlock()  { dccpp_rmutex_unlock(p_); }
    private:
        dccpp_recursive_mutex* p_;
    };

    template <class M>
    class lock_guard {
    public:
        lock_guard(M& m) : m_(m), locked_(1) { m_.lock(); }
        ~lock_guard() { if (locked_) m_.unlock(); }
        lock_guard(const lock_guard&) = 0;
        lock_guard& operator=(const lock_guard&) = 0;
    private:
        M& m_;
        int locked_;
    };
}
