// <source_location> - C++20 source location
#ifndef _DCC_SOURCE_LOCATION
#define _DCC_SOURCE_LOCATION

#include <cstdint>

namespace std {

class source_location {
public:
  static constexpr source_location current() noexcept {
    return source_location();
  }
  
  constexpr uint_least32_t line() const noexcept { return 0; }
  constexpr uint_least32_t column() const noexcept { return 0; }
  constexpr const char* file_name() const noexcept { return ""; }
  constexpr const char* function_name() const noexcept { return ""; }
};

} // namespace std

#endif // _DCC_SOURCE_LOCATION
