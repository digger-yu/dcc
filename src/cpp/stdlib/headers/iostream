// <iostream> - dcc++ C++ 标准库 (stub version)
// 简化版本：使用 void*代替 opaque pointer 以避免 ABI calculation 问题

namespace std {
    // Use void* to avoid native backend issues with opaque types
    class ostream {
        void* p_;
    public:
        ostream() : p_(0) {}
        ostream(void* impl) : p_(impl) {}

        ostream& operator<<(const char* s) { return *this; }
        ostream& operator<<(char c) { return *this; }
        ostream& operator<<(int v) { return *this; }
        ostream& operator<<(unsigned v) { return *this; }
        ostream& operator<<(long v) { return *this; }
        ostream& operator<<(unsigned long v) { return *this; }
        ostream& operator<<(long long v) { return *this; }
        ostream& operator<<(unsigned long long v) { return *this; }
        ostream& operator<<(double v) { return *this; }
        ostream& operator<<(float v) { return *this; }
        ostream& operator<<(const void* p) { return *this; }
        ostream& operator<<(bool v) { return *this; }

        void flush() {}
    };

    class istream {
        void* p_;
    public:
        istream() : p_(0) {}
        istream(void* impl) : p_(impl) {}

        istream& operator>>(int& v) { return *this; }
        istream& operator>>(long& v) { return *this; }
        istream& operator>>(long long& v) { return *this; }
        istream& operator>>(unsigned& v) { return *this; }
        istream& operator>>(unsigned long& v) { return *this; }
        istream& operator>>(unsigned long long& v) { return *this; }
        istream& operator>>(double& v) { return *this; }
        istream& operator>>(float& v) { return *this; }
        istream& operator>>(char& c) { return *this; }

        int get() { return 0; }
        int eof() { return 0; }
    };

    inline ostream& cout() {
        static ostream os;
        return os;
    }
    inline ostream& cerr() {
        static ostream os;
        return os;
    }
    inline ostream& clog() {
        static ostream os;
        return os;
    }
    inline istream& cin() {
        static istream is;
        return is;
    }

    inline ostream& endl(ostream& os) {
        return os;
    }

    // ws manipulator
    inline istream& ws(istream& is) {
        return is;
    }
}
