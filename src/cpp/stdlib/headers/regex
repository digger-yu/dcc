// <regex> - dcc++ C++ 标准库 (M18, 简化子集)
//
// std::basic_regex<char> 包装 dccpp_regex. 简化:
//   - 不支持 traits 模板 (用默认 char traits)
//   - 不支持 named capture, lookbehind, lookahead, word boundary
//   - 支持: 字面字符 / . / [...] / [a-z] / * / + / ? / | / () / ^ / $ / \x
// 匹配语义: 全字符串锚定, 失败返回 0.

extern "C" {
    struct dccpp_regex;
    dccpp_regex* dccpp_regex_compile(const char* pat);
    void         dccpp_regex_free(dccpp_regex* r);
    int          dccpp_regex_match(dccpp_regex* r, const char* s);
}

namespace std {
    class regex {
    public:
        regex() : p_(0) {}
        regex(const char* pat) : p_(dccpp_regex_compile(pat)) {}
        ~regex() { if (p_) dccpp_regex_free(p_); }
        regex(const regex&) = 0;
        regex& operator=(const regex&) = 0;

        int match(const char* s) const {
            if (!p_) return 0;
            return dccpp_regex_match(p_, s);
        }
        int match_ok() const { return p_ != 0; }
    private:
        dccpp_regex* p_;
    };
}
