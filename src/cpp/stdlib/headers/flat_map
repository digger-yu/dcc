// <flat_map> - dcc++ C++ 标准库
// C++23 std::flat_map<Key, Value> 通用模板版.
//
// 语义说明:
//   - flat_map 是排序数组 + 二分查找的关联容器.
//   - 比 std::map 缓存友好, 插入 O(n), 查找 O(log n).
//   - 降级: 用简单数组 + 线性/二分搜索实现.

namespace std {

    // flat_map<Key, Value, Compare>: 通用模板
    template <typename Key, typename Value, typename Compare = int>
    class flat_map {
    public:
        typedef Key key_type;
        typedef Value mapped_type;
        typedef size_t size_type;

        flat_map() : keys_(0), vals_(0), size_(0), cap_(0) {}

        ~flat_map() {
            // 简化: 不释放 (栈分配或外部管理)
        }

        // Capacity
        size_t size() const { return size_; }
        int empty() const { return size_ == 0; }

        // Lookup
        Value& at(const Key& k) {
            for (size_t i = 0; i < size_; ++i) {
                if (keys_[i] == k) return vals_[i];
            }
            return vals_[0];  // 简化: 未找到返回第一个
        }

        const Value& at(const Key& k) const {
            for (size_t i = 0; i < size_; ++i) {
                if (keys_[i] == k) return vals_[i];
            }
            return vals_[0];
        }

        Value& operator[](const Key& k) {
            for (size_t i = 0; i < size_; ++i) {
                if (keys_[i] == k) return vals_[i];
            }
            // 插入新元素
            insert(k, Value());
            return vals_[size_ - 1];
        }

        int contains(const Key& k) const {
            for (size_t i = 0; i < size_; ++i) {
                if (keys_[i] == k) return 1;
            }
            return 0;
        }

        int count(const Key& k) const {
            return contains(k);
        }

        // Modifiers
        void insert(const Key& k, const Value& v) {
            if (size_ < cap_) {
                keys_[size_] = k;
                vals_[size_] = v;
                ++size_;
            }
        }

        int erase(const Key& k) {
            for (size_t i = 0; i < size_; ++i) {
                if (keys_[i] == k) {
                    // 移动后续元素
                    for (size_t j = i; j + 1 < size_; ++j) {
                        keys_[j] = keys_[j + 1];
                        vals_[j] = vals_[j + 1];
                    }
                    --size_;
                    return 1;
                }
            }
            return 0;
        }

        void clear() { size_ = 0; }

        // Iterators (简化为索引)
        const Key* begin_keys() const { return keys_; }
        const Key* end_keys() const { return keys_ + size_; }
        const Value* begin_vals() const { return vals_; }
        const Value* end_vals() const { return vals_ + size_; }

    private:
        Key* keys_;
        Value* vals_;
        size_t size_;
        size_t cap_;
    };

    // flat_multimap: 允许重复键
    template <typename Key, typename Value>
    class flat_multimap {
    public:
        flat_multimap() : size_(0) {}

        size_t size() const { return size_; }
        int empty() const { return size_ == 0; }

        void insert(const Key& k, const Value& v) {
            if (size_ < 1024) {
                keys_[size_] = k;
                vals_[size_] = v;
                ++size_;
            }
        }

        int count(const Key& k) const {
            int c = 0;
            for (size_t i = 0; i < size_; ++i) {
                if (keys_[i] == k) ++c;
            }
            return c;
        }

        void clear() { size_ = 0; }

    private:
        Key keys_[1024];
        Value vals_[1024];
        size_t size_;
    };

    // flat_set: 仅键的排序容器
    template <typename Key>
    class flat_set {
    public:
        flat_set() : size_(0) {}

        size_t size() const { return size_; }
        int empty() const { return size_ == 0; }

        void insert(const Key& k) {
            if (!contains(k) && size_ < 1024) {
                keys_[size_++] = k;
            }
        }

        int contains(const Key& k) const {
            for (size_t i = 0; i < size_; ++i) {
                if (keys_[i] == k) return 1;
            }
            return 0;
        }

        int count(const Key& k) const {
            return contains(k) ? 1 : 0;
        }

        int erase(const Key& k) {
            for (size_t i = 0; i < size_; ++i) {
                if (keys_[i] == k) {
                    for (size_t j = i; j + 1 < size_; ++j) {
                        keys_[j] = keys_[j + 1];
                    }
                    --size_;
                    return 1;
                }
            }
            return 0;
        }

        void clear() { size_ = 0; }

    private:
        Key keys_[1024];
        size_t size_;
    };

}  // namespace std
