// <tuple> - dcc++ C++ 标准库
// std::tuple<Types...> 固定大小异质容器.
//
// 语义说明:
//   - tuple 降级为 C 结构体, 字段按类型顺序排列.
//   - get<I>(t) 通过模板特化访问第 I 个元素.
//   - tuple_size / tuple_element 提供元信息.
//   - make_tuple / tie 辅助函数.
//   - dcc 简化: 最多支持 4 个元素的特化.

namespace std {

    // ===== tuple primary template (variadic) =====
    template <typename... Types>
    class tuple;

    // 0-element tuple
    template <>
    class tuple<> {
    public:
        tuple() {}
    };

    // 1-element tuple
    template <typename T0>
    class tuple<T0> {
    public:
        T0 _0;
        tuple() : _0() {}
        tuple(const T0& v0) : _0(v0) {}
    };

    // 2-element tuple
    template <typename T0, typename T1>
    class tuple<T0, T1> {
    public:
        T0 _0;
        T1 _1;
        tuple() : _0(), _1() {}
        tuple(const T0& v0, const T1& v1) : _0(v0), _1(v1) {}
    };

    // 3-element tuple
    template <typename T0, typename T1, typename T2>
    class tuple<T0, T1, T2> {
    public:
        T0 _0;
        T1 _1;
        T2 _2;
        tuple() : _0(), _1(), _2() {}
        tuple(const T0& v0, const T1& v1, const T2& v2)
            : _0(v0), _1(v1), _2(v2) {}
    };

    // 4-element tuple
    template <typename T0, typename T1, typename T2, typename T3>
    class tuple<T0, T1, T2, T3> {
    public:
        T0 _0;
        T1 _1;
        T2 _2;
        T3 _3;
        tuple() : _0(), _1(), _2(), _3() {}
        tuple(const T0& v0, const T1& v1, const T2& v2, const T3& v3)
            : _0(v0), _1(v1), _2(v2), _3(v3) {}
    };

    // ===== get<I> access =====
    template <size_t I, typename... Types>
    struct tuple_element;

    template <typename T0>
    struct tuple_element<0, tuple<T0> > {
        typedef T0 type;
    };

    template <typename T0, typename T1>
    struct tuple_element<0, tuple<T0, T1> > {
        typedef T0 type;
    };
    template <typename T0, typename T1>
    struct tuple_element<1, tuple<T0, T1> > {
        typedef T1 type;
    };

    template <typename T0, typename T1, typename T2>
    struct tuple_element<0, tuple<T0, T1, T2> > { typedef T0 type; };
    template <typename T0, typename T1, typename T2>
    struct tuple_element<1, tuple<T0, T1, T2> > { typedef T1 type; };
    template <typename T0, typename T1, typename T2>
    struct tuple_element<2, tuple<T0, T1, T2> > { typedef T2 type; };

    // get<I> implementations
    template <size_t I, typename... Types>
    typename tuple_element<I, tuple<Types...> >::type&
    get(tuple<Types...>& t);

    template <size_t I, typename... Types>
    const typename tuple_element<I, tuple<Types...> >::type&
    get(const tuple<Types...>& t);

    // ===== tuple_size =====
    template <typename T>
    struct tuple_size;

    template <> struct tuple_size<tuple<> > { static const size_t value = 0; };
    template <typename T0>
    struct tuple_size<tuple<T0> > { static const size_t value = 1; };
    template <typename T0, typename T1>
    struct tuple_size<tuple<T0, T1> > { static const size_t value = 2; };
    template <typename T0, typename T1, typename T2>
    struct tuple_size<tuple<T0, T1, T2> > { static const size_t value = 3; };
    template <typename T0, typename T1, typename T2, typename T3>
    struct tuple_size<tuple<T0, T1, T2, T3> > { static const size_t value = 4; };

    // ===== make_tuple =====
    template <typename T0>
    tuple<T0> make_tuple(const T0& v0) {
        return tuple<T0>(v0);
    }
    template <typename T0, typename T1>
    tuple<T0, T1> make_tuple(const T0& v0, const T1& v1) {
        return tuple<T0, T1>(v0, v1);
    }
    template <typename T0, typename T1, typename T2>
    tuple<T0, T1, T2> make_tuple(const T0& v0, const T1& v1, const T2& v2) {
        return tuple<T0, T1, T2>(v0, v1, v2);
    }

}  // namespace std
