// <span> - dcc++ C++ 标准库
// std::span<T> (C++20) 连续序列的非拥有视图.
//
// 语义说明:
//   - span<T> 降级为 T* + size_t.
//   - 不拥有内存, 类似 string_view 但适用于任意类型.
//   - 动态_extent 表示运行时大小.

namespace std {

    static const size_t dynamic_extent = (size_t)-1;

    template <typename T, size_t Extent = dynamic_extent>
    class span {
    public:
        typedef T element_type;
        typedef T value_type;
        typedef size_t size_type;
        typedef T* pointer;
        typedef const T* const_pointer;
        typedef T& reference;
        typedef const T& const_reference;
        typedef T* iterator;
        typedef const T* const_iterator;

        // Constructors
        span() : data_(0), size_(0) {}
        span(T* ptr, size_t count) : data_(ptr), size_(count) {}
        span(T* first, T* last) : data_(first), size_(last - first) {}

        // From array
        template <size_t N>
        span(T (&arr)[N]) : data_(arr), size_(N) {}

        // Iterators
        iterator begin() const { return data_; }
        iterator end() const { return data_ + size_; }
        const_iterator cbegin() const { return data_; }
        const_iterator cend() const { return data_ + size_; }

        // Element access
        T& operator[](size_t idx) const { return data_[idx]; }
        T& front() const { return data_[0]; }
        T& back() const { return data_[size_ - 1]; }
        T* data() const { return data_; }

        // Capacity
        size_t size() const { return size_; }
        size_t size_bytes() const { return size_ * sizeof(T); }
        int empty() const { return size_ == 0; }

        // Subviews
        span<T, dynamic_extent> first(size_t count) const {
            return span<T, dynamic_extent>(data_, count);
        }
        span<T, dynamic_extent> last(size_t count) const {
            return span<T, dynamic_extent>(data_ + size_ - count, count);
        }
        span<T, dynamic_extent> subspan(size_t offset, size_t count) const {
            return span<T, dynamic_extent>(data_ + offset, count);
        }

    private:
        T* data_;
        size_t size_;
    };

    // make_span helper
    template <typename T>
    span<T> make_span(T* ptr, size_t count) {
        return span<T>(ptr, count);
    }

}  // namespace std
