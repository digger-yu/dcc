{
  "$schema": "../../instruction_spec_schema.json",
  "name": "cmp",
  "description": "Compare two operands by subtracting and setting flags",
  "arch": "x8664",
  "encoding_spec": {
    "formats": [
      {
        "name": "RegReg",
        "description": "Register to register comparison",
        "operand_pattern": "reg reg",
        "opcode": [57],
        "modrm_required": true
      },
      {
        "name": "ImmReg",
        "description": "Immediate to register comparison",
        "operand_pattern": "imm reg",
        "opcode": [129, 248],
        "rex_prefix": true,
        "extra_bytes": true
      }
    ],
    "default_format": "RegReg"
  },
  "operands": [
    {
      "name": "op1",
      "op_type": "reg",
      "direction": "read",
      "description": "First operand (will be compared)"
    },
    {
      "name": "op2",
      "op_type": "regmemimmediate",
      "direction": "read",
      "description": "Second operand"
    }
  ],
  "semantics": {
    "effect": "flags = op1 - op2 (result discarded)",
    "flags_modified": ["CF", "OF", "SF", "ZF", "AF", "PF"],
    "exceptions": null,
    "cpu_modes": ["real", "protected", "long"]
  },
  "aliases": ["compare"],
  "examples": [
    {
      "assembly": "cmp eax, ebx",
      "machine_code_hex": "39 D8",
      "description": "Compare EAX with EBX"
    }
  ]
}
