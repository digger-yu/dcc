{
  "$schema": "../../instruction_spec_schema.json",
  "name": "and",
  "description": "Bitwise logical AND of two operands",
  "arch": "x8664",
  "encoding_spec": {
    "formats": [
      {
        "name": "RegReg",
        "description": "Register to register AND",
        "operand_pattern": "reg reg",
        "opcode": [33],
        "modrm_required": true
      }
    ],
    "default_format": "RegReg"
  },
  "operands": [
    {
      "name": "dest",
      "op_type": "reg",
      "direction": "readwrite",
      "description": "Destination register (also first operand)"
    },
    {
      "name": "src",
      "op_type": "regmemimmediate",
      "direction": "read",
      "description": "Source operand for bitwise AND"
    }
  ],
  "semantics": {
    "effect": "dest = dest & src",
    "flags_modified": ["CF", "OF", "SF", "ZF", "AF", "PF"],
    "exceptions": null,
    "cpu_modes": ["real", "protected", "long"]
  },
  "aliases": [],
  "examples": [
    {
      "assembly": "and eax, ebx",
      "machine_code_hex": "21 D8",
      "description": "EAX = EAX & EBX"
    }
  ]
}
