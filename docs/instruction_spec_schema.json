{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Instruction Specification Schema",
  "description": "Schema for defining instruction specifications in DCC compiler data-driven encoding layer",
  "type": "object",
  "required": ["name", "arch", "encoding_spec"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to the schema version"
    },
    "name": {
      "type": "string",
      "description": "Instruction name (lowercase, e.g., 'add', 'sub')",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the instruction"
    },
    "arch": {
      "type": "string",
      "description": "Target architecture",
      "enum": ["x86_64", "aarch64", "riscv64"]
    },
    "operands": {
      "type": "array",
      "description": "List of operands supported by this instruction",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Operand identifier used in templates"
          },
          "type": {
            "type": "string",
            "description": "Type of operand",
            "enum": ["reg", "mem", "regmem", "immediate", "memory"]
          },
          "direction": {
            "type": "string",
            "description": "Operand direction",
            "enum": ["read", "write", "read_write", "none"]
          },
          "size": {
            "type": "string",
            "description": "Operand size hint (e.g., '32bit', '64bit')"
          },
          "registers": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Specific registers (if restricted)"
          }
        }
      }
    },
    "encoding_spec": {
      "type": "object",
      "required": ["formats"],
      "properties": {
        "formats": {
          "type": "array",
          "description": "Different encoding formats available for this instruction",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "opcode", "operand_pattern"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Format name (e.g., 'RegMemReg', 'ImmediateReg')"
              },
              "description": {
                "type": "string",
                "description": "Description of this encoding format"
              },
              "operand_pattern": {
                "type": "string",
                "description": "Expected operand pattern (e.g., 'r/m r', 'imm r')"
              },
              "opcode": {
                "type": "array",
                "items": {"type": "integer", "minimum": 0, "maximum": 255},
                "description": "Base opcode bytes (can be prefixed with ModR/M)"
              },
              "modrm_required": {
                "type": "boolean",
                "description": "Whether ModR/M byte is required"
              },
              "rex_prefix": {
                "type": "boolean",
                "description": "Whether REX prefix may be needed (x86 only)"
              },
              "escape_bytes": {
                "type": "array",
                "items": {"type": "integer"},
                "description": "Escape/extension bytes if any"
              },
              "addressing_mode": {
                "type": "string",
                "description": "Addressing mode template"
              }
            }
          }
        },
        "default_format": {
          "type": "string",
          "description": "Name of default encoding format to use"
        }
      }
    },
    "semantics": {
      "type": "object",
      "description": "Instruction semantics and side effects",
      "properties": {
        "effect": {
          "type": "string",
          "description": "Formal effect description using mathematical notation"
        },
        "flags_modified": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ZF", "SF", "OF", "CF", "PF", "AF"]
          },
          "description": "Flags modified by this instruction"
        },
        "exceptions": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Exceptions that may be raised"
        },
        "cpu_modes": {
          "type": "array",
          "items": {"type": "string"},
          "description": "CPU modes where this instruction is valid"
        }
      }
    },
    "validation_rules": {
      "type": "object",
      "description": "Custom validation rules for operands",
      "properties": {
        "max_operands": {
          "type": "integer",
          "minimum": 1
        },
        "operand_constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {"type": "integer"},
              "requirement": {"type": "string"}
            }
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Alternative names for this instruction"
    }
  },
  "additionalProperties": false
}
